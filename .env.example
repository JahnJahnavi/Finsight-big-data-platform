# =============================================================================
# FinSight - environment configuration TEMPLATE
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in the CHANGE_ME values before starting the stack:
#     cp .env.example .env          (bash)
#     Copy-Item .env.example .env   (PowerShell)
#
# `.env` is git-ignored. NEVER commit real credentials.
# =============================================================================

# --- Compose ---------------------------------------------------------------
# Which optional service groups to start. Remove groups on low-memory machines.
COMPOSE_PROFILES=tools,connect,hive,spark

# =============================================================================
# KAFKA
# =============================================================================
KAFKA_HOST_PORT=9092
KAFKA_UI_HOST_PORT=8085
KAFKA_CONNECT_HOST_PORT=8083
# 22-char base64 cluster id used to format the KRaft metadata log.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Bootstrap endpoints (host tools use the first, in-container services the second)
KAFKA_BOOTSTRAP_SERVERS_HOST=localhost:9092
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Topic names / partitioning (topics are CREATED in Phase 2, listed here now)
KAFKA_TOPIC_RAW=txn-raw
KAFKA_TOPIC_FLAGGED=txn-flagged
KAFKA_TOPIC_CHURN=txn-churn
KAFKA_TOPIC_RAW_PARTITIONS=3
KAFKA_TOPIC_FLAGGED_PARTITIONS=1
KAFKA_TOPIC_CHURN_PARTITIONS=1
KAFKA_TOPIC_REPLICATION=1
KAFKA_CONNECT_URL=http://localhost:8083
CONNECT_URL=http://localhost:8083

# --- Phase 3: HDFS sink connector (scripts/register_hdfs_sink.py) ---
# Optional overrides for docker/kafka-connect/connectors/hdfs-sink-txn-raw.json
CONNECT_FLUSH_SIZE=2000
CONNECT_ROTATE_SCHEDULE_MS=300000
CONNECT_TASKS_MAX=3

# --- Phase 2/3: producer message format ---
# false (default) = Kafka Connect JSON schema envelope (required by the HDFS sink)
# true            = bare JSON payload
PRODUCER_RAW=false

# =============================================================================
# HDFS
# =============================================================================
HDFS_NAMENODE_UI_PORT=9870
HDFS_NAMENODE_RPC_PORT=8020
HDFS_DATANODE_UI_PORT=9864
HDFS_NAMENODE_URL=hdfs://localhost:8020
# In-container namenode address used by Spark / Hive / Connect
HDFS_NAMENODE_INTERNAL=hdfs://namenode:8020

# Canonical HDFS layout (scripts/init_hdfs.sh)
HDFS_BASE=/finsight
# Kafka Connect HDFS sink lands raw transaction Parquet here (topic name is
# appended by the connector - see docs/phase-03-hdfs.md / ASSUMPTIONS I5b).
HDFS_RAW_TXN=/finsight/raw/txn-raw
HDFS_CHECKPOINT_FRAUD=/finsight/checkpoints/fraud
HDFS_CHECKPOINT_CHURN=/finsight/checkpoints/churn
HDFS_STREAMING_METRICS=/finsight/processed/streaming_metrics
HDFS_CHURN_ALERTS=/finsight/processed/churn_alerts
HDFS_RISK_SCORES=/finsight/processed/risk_scores
HDFS_DAILY_SUMMARY=/finsight/processed/daily_summary
HDFS_CLV_SCORES=/finsight/processed/clv_scores
HDFS_CUSTOMER_FRAUD_SUMMARY=/finsight/processed/customer_fraud_summary
HDFS_DORMANCY=/finsight/processed/dormancy_report
HDFS_EXPORTS=/finsight/exports

# =============================================================================
# SPARK
# =============================================================================
SPARK_MASTER_UI_PORT=8080
SPARK_MASTER_RPC_PORT=7077
SPARK_WORKER_UI_PORT=8081
SPARK_WORKER_MEMORY=1200M
SPARK_WORKER_CORES=4
SPARK_MASTER_URL=spark://localhost:7077
SPARK_MASTER_URL_INTERNAL=spark://spark-master:7077

# Distinct application names (spec 7.4 R2 - separate Spark UI monitoring)
SPARK_APPNAME_FRAUD=finsight-streaming-fraud
SPARK_APPNAME_CHURN=finsight-streaming-churn
SPARK_APPNAME_RISK=finsight-batch-risk
SPARK_APPNAME_CLV=finsight-batch-clv
SPARK_APPNAME_SQL=finsight-spark-sql

# --- Phase 4/5: Structured Streaming (fraud_detection.py / churn_detection.py) ---
SPARK_KAFKA_PKG_VERSION=3.5.3
SPARK_STREAM_TRIGGER=10 seconds
SPARK_KAFKA_STARTING_OFFSETS=latest
SPARK_KAFKA_MAX_OFFSETS_PER_TRIGGER=100000
# spark-submit resource caps for the streaming driver/executors on the dev box
SPARK_DRIVER_MEMORY=512m
SPARK_EXECUTOR_MEMORY=512m
SPARK_CORES_MAX=2

# --- Phase 5: churn detection (spec 7.2 - values are frozen, override with care) ---
CHURN_SLIDE_STEPS=12
CHURN_WATERMARK=48 hours
CHURN_FREQ_LOW_PER_12=1.0
CHURN_FREQ_HIST_PER_12=3.0
CHURN_AMOUNT_DROP_FRACTION=0.20
CHURN_BALANCE_LOW_THRESHOLD=500.0
CHURN_BALANCE_LOW_CONSECUTIVE=2
HDFS_CUSTOMER_BASELINE=/finsight/processed/customer_baseline

# =============================================================================
# HIVE
# =============================================================================
HIVE_METASTORE_PORT=9083
HIVESERVER2_PORT=10000
HIVESERVER2_UI_PORT=10002
HIVE_METASTORE_URI=thrift://localhost:9083
HIVE_METASTORE_URI_INTERNAL=thrift://hive-metastore:9083
HIVESERVER2_JDBC=jdbc:hive2://localhost:10000/finsight
HIVE_DB=finsight

# Metastore backend database (PostgreSQL)
HIVE_DB_USER=hive
HIVE_DB_PASSWORD=CHANGE_ME_hive_pg_pw

# =============================================================================
# MONGODB
# =============================================================================
MONGO_PORT=27017
MONGO_DB=finsight
MONGO_COLLECTION=customers
MONGO_INITDB_ROOT_USERNAME=finsight_admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_mongo_root_pw
# Full connection string for Python clients (Phase 3+)
MONGO_URI=mongodb://finsight_admin:CHANGE_ME_mongo_root_pw@localhost:27017/finsight?authSource=admin

# =============================================================================
# NEO4J
# =============================================================================
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_neo4j_pw
NEO4J_URI=bolt://localhost:7687
NEO4J_URI_INTERNAL=bolt://neo4j:7687
NEO4J_FRAUD_RING_MIN_SENDERS=3

# =============================================================================
# BUSINESS-RULE CONSTANTS  (frozen from FinSight_Full_Specification_Complete.pdf)
# Do NOT change - see docs/ASSUMPTIONS.md for anything not defined by the spec.
# =============================================================================
FRAUD_AMOUNT_THRESHOLD=200000
FRAUD_TYPES=TRANSFER,CASH_OUT
CHURN_WINDOW_STEPS=24
CHURN_MIN_SIGNALS=2
RISK_TIER_LOW_MAX=0.25
RISK_TIER_MEDIUM_MAX=0.60
# Phase 6 risk-score factor weights. Spec 7.3 names the 4 factors but gives NO
# weights (docs/ASSUMPTIONS.md G6) - default equal 0.25, needs sign-off.
RISK_W_FREQUENCY=0.25
RISK_W_AVG_TRANSFER=0.25
RISK_W_CASHOUT_PROP=0.25
RISK_W_UNIQUE_DEST=0.25
CLV_W_VOLUME=0.30
CLV_W_FREQUENCY=0.25
CLV_W_DIVERSITY=0.25
CLV_W_RECENCY=0.20
CLV_RECENCY_ZERO_AFTER_STEPS=48
CLV_TIER_HIGH_MIN=0.70
CLV_TIER_GROWTH_MIN=0.40
DORMANCY_INACTIVE_STEPS=72
DORMANCY_SEVERE_STEPS=120
DORMANCY_MIN_HISTORY=5
COMPLIANCE_WINDOW_STEPS=168
# ASSUMPTION (docs/ASSUMPTIONS.md G11): simulation step 1 == this UTC instant
SIM_EPOCH=2023-01-01T00:00:00Z

# =============================================================================
# PIPELINE / APP SETTINGS
# =============================================================================
PRODUCER_TARGET_RATE=1000
PRODUCER_SOURCE_CSV=./data/raw/NovaCrest_Transactions.csv
CUSTOMERS_JSON=./data/raw/noveacrest_customers.json
SAMPLE_MODE=true
SAMPLE_LIMIT=5000
LOG_LEVEL=INFO

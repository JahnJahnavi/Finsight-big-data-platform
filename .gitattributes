# Keep shell scripts and configs LF so they run inside Linux containers on Windows.
*.sh            text eol=lf
*.env           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.xml           text eol=lf
*.conf          text eol=lf
Dockerfile      text eol=lf
*.ps1           text eol=crlf

# Never let git mangle data / binaries
*.csv           binary
*.parquet       binary
*.avro          binary
*.pbix          binary
*.xlsx          binary
*.pdf           binary
